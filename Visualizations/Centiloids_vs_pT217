# ============================================================
# 2. Helper function:
#    fit spline model + compute marginal standardized curves
# ============================================================

def fit_spline_and_get_curves(
    data,
    formula,
    x_var="centiloids",
    race_var="race_black",
    grid_points=200,
    robust=True
):
    """
    Fits spline regression and returns marginal standardized
    predicted curves by race with 95% CIs.
    """

    model = smf.ols(formula, data=data).fit()

    if robust:
        model_robust = model.get_robustcov_results(cov_type="HC3")
        beta = np.asarray(model_robust.params)
        vcov = np.asarray(model_robust.cov_params())
    else:
        beta = np.asarray(model.params)
        vcov = np.asarray(model.cov_params())

    design_info = model.model.data.design_info

    x_grid = np.linspace(
        data[x_var].min(),
        data[x_var].max(),
        grid_points
    )

    out = []

    for race_value, race_label in [(0, "NHW"), (1, "B/AA")]:
        for x in x_grid:

            temp = data.copy()
            temp[race_var] = race_value
            temp[x_var] = x

            X = np.asarray(
                build_design_matrices([design_info], temp)[0]
            )

            xbar = X.mean(axis=0)

            pred = float(xbar @ beta)
            se = float(np.sqrt(np.maximum(xbar @ vcov @ xbar, 0)))

            out.append({
                x_var: x,
                "race_black": race_value,
                "race_group": race_label,
                "fit": pred,
                "lower": pred - 1.96 * se,
                "upper": pred + 1.96 * se
            })

    curve_df = pd.DataFrame(out)
    return model, curve_df


