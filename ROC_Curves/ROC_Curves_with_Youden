import numpy as np
import pandas as pd

from sklearn.metrics import roc_curve, roc_auc_score
import matplotlib.pyplot as plt

# -----------------------------
# CONFIGURATION
# -----------------------------
DX_COL      = "madc_dx"         
DATASET_COL = "dataset"         # "MADRC" / "NACC"
RACE_COL    = "race_black"      # 0=White, 1=Black
SCORE_COL   = "ptau217"        
POS_LABEL   = "DAT"
NEG_LABEL   = "CU"

N_BOOT_CI   = 2000              # for AUC CI + p-value tests
RANDOM_SEED = 2026

# -----------------------------
# Helper: bootstrap AUC CI
# -----------------------------
def bootstrap_auc_ci(y, score, n_boot=2000, seed=2026):
    rng = np.random.default_rng(seed)
    y = np.asarray(y)
    score = np.asarray(score)

    # must have both classes
    if len(np.unique(y)) < 2:
        return np.nan, (np.nan, np.nan), np.array([])

    auc_point = roc_auc_score(y, score)

    auc_boot = []
    n = len(y)
    for _ in range(n_boot):
        idx = rng.integers(0, n, n)
        y_b = y[idx]
        s_b = score[idx]
        # skip resamples with single class
        if len(np.unique(y_b)) < 2:
            continue
        auc_boot.append(roc_auc_score(y_b, s_b))

    auc_boot = np.array(auc_boot)
    if len(auc_boot) < 50:
        return auc_point, (np.nan, np.nan), auc_boot

    lo, hi = np.percentile(auc_boot, [2.5, 97.5])
    return auc_point, (lo, hi), auc_boot

# -----------------------------
# Helper: Youden J cutoff
# -----------------------------
def youden_cutoff(y, score):
    y = np.asarray(y)
    score = np.asarray(score)

    fpr, tpr, thr = roc_curve(y, score)
    j = tpr - fpr  # Youden J = Sens + Spec - 1 = TPR - FPR
    k = np.nanargmax(j)

    cutoff = thr[k]
    sens = tpr[k]
    spec = 1 - fpr[k]

    return {
        "cutoff_youden": cutoff,
        "sensitivity": sens,
        "specificity": spec
    }

# -----------------------------
# Helper: bootstrap p-value for difference in AUCs (independent groups)
# -----------------------------
def bootstrap_auc_diff_pvalue(y1, s1, y2, s2, n_boot=2000, seed=2026):
    rng = np.random.default_rng(seed)
    y1 = np.asarray(y1); s1 = np.asarray(s1)
    y2 = np.asarray(y2); s2 = np.asarray(s2)

    # point estimate
    if len(np.unique(y1)) < 2 or len(np.unique(y2)) < 2:
        return np.nan, np.nan

    auc1 = roc_auc_score(y1, s1)
    auc2 = roc_auc_score(y2, s2)
    diff_point = auc1 - auc2

    diffs = []
    n1 = len(y1); n2 = len(y2)

    for _ in range(n_boot):
        idx1 = rng.integers(0, n1, n1)
        idx2 = rng.integers(0, n2, n2)
        y1b, s1b = y1[idx1], s1[idx1]
        y2b, s2b = y2[idx2], s2[idx2]
        if len(np.unique(y1b)) < 2 or len(np.unique(y2b)) < 2:
            continue
        diffs.append(roc_auc_score(y1b, s1b) - roc_auc_score(y2b, s2b))

    diffs = np.array(diffs)
    if len(diffs) < 50:
        return diff_point, np.nan

    # two-sided p-value for H0: diff = 0 using bootstrap distribution
    p = 2 * min(np.mean(diffs <= 0), np.mean(diffs >= 0))
    return diff_point, p

# -----------------------------
# Main analysis function
# -----------------------------
def run_roc_by_dataset_and_race(df, make_plots=True, out_dir="roc_outputs"):
    import os
    os.makedirs(out_dir, exist_ok=True)

    # Keep CU and DAT only
    d = df.copy()
    d = d[d[DX_COL].isin([NEG_LABEL, POS_LABEL])].copy()

    # Outcome: 1=DAT, 0=CU
    d["y"] = (d[DX_COL] == POS_LABEL).astype(int)

    # Numeric score
    d[SCORE_COL] = pd.to_numeric(d[SCORE_COL], errors="coerce")

    # Race label
    d["race_group"] = d[RACE_COL].map({0: "White", 1: "Black"})
    d["race_group"] = d["race_group"].astype("category")

    # Datasets to evaluate
    dataset_levels = ["MADRC", "NACC", "Combined"]

    results_rows = []

    for ds in dataset_levels:
        if ds == "Combined":
            sub = d.copy()
        else:
            sub = d[d[DATASET_COL] == ds].copy()

        # Prepare a ROC plot per dataset
        fig, ax = None, None
        if make_plots:
            fig, ax = plt.subplots(figsize=(5, 5))
            ax.plot([0, 1], [0, 1], linestyle="--", linewidth=1)
            ax.set_title(f"ROC: {NEG_LABEL} vs {POS_LABEL} ({ds})\nScore={SCORE_COL}")
            ax.set_xlabel("Specificity")
            ax.set_ylabel("Sensitivity")

        # Run per race
        auc_info = {}
        roc_info = {}

        for race in ["White", "Black"]:
            sub_r = (
                sub[sub["race_group"] == race]
                .dropna(subset=["y", SCORE_COL])
                .copy()
            )
        
            # Count CU and DAT
            n_CU  = int((sub_r["y"] == 0).sum())
            n_DAT = int((sub_r["y"] == 1).sum())
        
            # Need both classes present
            if sub_r["y"].nunique() < 2 or len(sub_r) < 10:
                results_rows.append({
                    "dataset": ds,
                    "race": race,
                    "n": len(sub_r),
                    "n_CU": n_CU,
                    "n_DAT": n_DAT,
                    "auc": np.nan,
                    "auc_ci_low": np.nan,
                    "auc_ci_high": np.nan,
                    "youden_cutoff": np.nan,
                    "sensitivity": np.nan,
                    "specificity": np.nan
                })
                continue

            y = sub_r["y"].to_numpy()
            score = sub_r[SCORE_COL].to_numpy()

            # AUC + CI
            auc, (lo, hi), auc_boot = bootstrap_auc_ci(
                y, score, n_boot=N_BOOT_CI, seed=RANDOM_SEED
            )

            # Youden cutoff
            yd = youden_cutoff(y, score)

            # ROC curve
            fpr, tpr, thr = roc_curve(y, score)

            auc_info[race] = (y, score, auc)
            roc_info[race] = (fpr, tpr)

            results_rows.append({
                "dataset": ds,
                "race": race,
                "n": len(sub_r),
                "n_CU": n_CU,
                "n_DAT": n_DAT,
                "auc": auc,
                "auc_ci_low": lo,
                "auc_ci_high": hi,
                "youden_cutoff": yd["cutoff_youden"],
                "sensitivity": yd["sensitivity"],
                "specificity": yd["specificity"]
            })
            if make_plots:
                label = f"{race}: AUC={auc:.3f} [{lo:.3f}, {hi:.3f}]"
                ax.plot(fpr, tpr, linewidth=1, label=label)

        # Compare White vs Black AUCs (within this dataset)
        # Bootstrap p-value (independent groups)
        if "White" in auc_info and "Black" in auc_info:
            yW, sW, aucW = auc_info["White"]
            yB, sB, aucB = auc_info["Black"]

            diff, p = bootstrap_auc_diff_pvalue(
                yW, sW, yB, sB, n_boot=N_BOOT_CI, seed=RANDOM_SEED
            )

            # store comparison in a row (or separate table)
            results_rows.append({
                "dataset": ds,
                "race": "White vs Black (AUC diff)",
                "n": np.nan,
                "n_CU": np.nan,
                "n_DAT": np.nan,
                "auc": diff,                      # here auc column holds diff
                "auc_ci_low": np.nan,
                "auc_ci_high": np.nan,
                "youden_cutoff": np.nan,
                "sensitivity": np.nan,
                "specificity": np.nan,
                "p_value_auc_diff_bootstrap": p
            })

        # Save plot
        if make_plots:
            ax.legend(loc="lower right")
            fig.tight_layout()
            fig.savefig(f"{out_dir}/ROC_{ds}_{SCORE_COL}.jpg", dpi=300, bbox_inches="tight")
            fig.savefig(f"{out_dir}/ROC_{ds}_{SCORE_COL}.tif", dpi=300, bbox_inches="tight")
            plt.close(fig)

    results = pd.DataFrame(results_rows)

    if "p_value_auc_diff_bootstrap" not in results.columns:
        results["p_value_auc_diff_bootstrap"] = np.nan

    results.to_csv(f"{out_dir}/roc_auc_summary_{SCORE_COL}.csv", index=False)
    return results

