Centiloids + comorbidities
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf
from patsy import cr

# ============================================================
# Centiloid natural cubic spline model (df=4)
# No race × Centiloid interaction
# ============================================================

analysis_df["centiloids"] = pd.to_numeric(
    analysis_df["centiloids"], errors="coerce"
).astype(float)

covariates = [
    "age", "sex", "apoe_pos", "educ_group", "dataset", "bmi", "diabetes", "hypertension", "hypercholesterol", "vascular_etiology"
]

cov_str = " + ".join(covariates)

# Exclude missing Centiloid values
df_pet = analysis_df[
    analysis_df["centiloids"].notna()
].copy()

# Natural cubic spline with 4 degrees of freedom
formula_pet = (
    f"log_ptau217 ~ race_black + "
    f"cr(centiloids, df=4, constraints='center') + {cov_str}"
)

# Fit model with HC3 robust standard errors
model_pet = smf.ols(
    formula_pet,
    data=df_pet
).fit(cov_type="HC3")

print(model_pet.summary())
