import numpy as np
import pandas as pd
import statsmodels.formula.api as smf

# -----------------------------
# Helpers
# -----------------------------
def compute_stabilized_ipw(df, treat, ps_formula, trunc=(0.1, 10), ps_min=1e-3, verbose=True):
    """
    Fit propensity score model within df and return df with:
      - ps
      - sw (stabilized weight)
      - sw_trunc (truncated)
    """
    d = df.copy()

    ps_model = smf.logit(ps_formula, data=d).fit(disp=False)
    if verbose:
        print(ps_model.summary())

    d["ps"] = ps_model.predict(d).clip(ps_min, 1 - ps_min)

    p_t = d[treat].mean()  # marginal P(T=1) in THIS analytic sample

    d["sw"] = np.where(
        d[treat] == 1,
        p_t / d["ps"],
        (1 - p_t) / (1 - d["ps"])
    )

    if trunc is not None:
        lo, hi = trunc
        d["sw_trunc"] = d["sw"].clip(lo, hi)
    else:
        d["sw_trunc"] = d["sw"]

    return d, ps_model


def weighted_mean(x, w):
    x = np.asarray(x)
    w = np.asarray(w)
    return np.sum(w * x) / np.sum(w)


def smd_unweighted(df, cov, treat="race_black"):
    g1 = df.loc[df[treat] == 1, cov].astype(float)
    g0 = df.loc[df[treat] == 0, cov].astype(float)
    m1, m0 = g1.mean(), g0.mean()
    s = np.sqrt((g1.var(ddof=1) + g0.var(ddof=1)) / 2)
    return (m1 - m0) / s


def smd_weighted(df, cov, treat="race_black", w="sw_trunc"):
    x1 = df.loc[df[treat] == 1, cov].astype(float)
    x0 = df.loc[df[treat] == 0, cov].astype(float)
    w1 = df.loc[df[treat] == 1, w].astype(float)
    w0 = df.loc[df[treat] == 0, w].astype(float)

    m1 = weighted_mean(x1, w1)
    m0 = weighted_mean(x0, w0)

    # quick pooled SD (unweighted) is ok for a quick diagnostic
    s = np.sqrt((x1.var(ddof=1) + x0.var(ddof=1)) / 2)
    return (m1 - m0) / s


