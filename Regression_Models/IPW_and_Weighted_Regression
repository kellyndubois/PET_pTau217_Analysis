if "centiloids" in df.columns:
    df["centiloids"] = pd.to_numeric(df["centiloids"], errors="coerce")

# -----------------------------
# (A) Full-sample IPW (Dx model)
# -----------------------------
covariates = ["age", "sex", "apoe_pos", "educ_group", "dataset", "madc_dx"]
needed_full = ["log_ptau217", "race_black"] + covariates

df_full = df.dropna(subset=needed_full).copy()

ps_formula_full = (
    "race_black ~ age + C(sex) + C(apoe_pos) + C(educ_group) + C(dataset) + C(madc_dx)"
)

df_full_w, ps_full = compute_stabilized_ipw(
    df_full, treat="race_black", ps_formula=ps_formula_full, trunc=(0.1, 10), verbose=True
)

formula_dx_ipw = (
    "log_ptau217 ~ race_black * C(madc_dx) + age + C(sex) + C(apoe_pos) + C(educ_group) + C(dataset)"
)
dx_ipw = smf.wls(formula_dx_ipw, data=df_full_w, weights=df_full_w["sw_trunc"]).fit()
print("\n--- Dx model (FULL weights) ---")
print(dx_ipw.summary())

