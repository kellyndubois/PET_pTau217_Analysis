import numpy as np
import pandas as pd
import statsmodels.formula.api as smf


def mediation_continuous(
    df,
    exposure="race_black",
    mediator="centiloids",
    outcome="log_ptau217",
    covariates=None,
    n_boot=5000,
    random_state=42
):
    if covariates is None:
        covariates = []

    # The supplied dataframe must already be complete-case.
    if df.isna().any().any():
        raise ValueError(
            "Input contains missing values. Create the complete-case "
            "mediation dataset before fitting."
        )

    if not set(df[exposure].unique()).issubset({0, 1}):
        raise ValueError("Exposure must be encoded as 0/1.")

    if df[exposure].nunique() != 2:
        raise ValueError("Both exposure groups must be present.")

    cov_str = (
        " + " + " + ".join(covariates)
        if covariates else ""
    )

    med_formula = (
        f"{mediator} ~ {exposure}{cov_str}"
    )
    out_formula = (
        f"{outcome} ~ {exposure} + {mediator}{cov_str}"
    )
    total_formula = (
        f"{outcome} ~ {exposure}{cov_str}"
    )

    def estimate(data):
        med_fit = smf.ols(med_formula, data=data).fit()
        out_fit = smf.ols(out_formula, data=data).fit()
        total_fit = smf.ols(total_formula, data=data).fit()

        a = med_fit.params[exposure]
        b = out_fit.params[mediator]
        c_prime = out_fit.params[exposure]
        total_direct = total_fit.params[exposure]

        return {
            "ACME": a * b,
            "ADE": c_prime,
            "Total": total_direct,
            "Total_from_paths": a * b + c_prime
        }

    point = estimate(df)

    if not np.isclose(
        point["Total"],
        point["Total_from_paths"],
        rtol=1e-6,
        atol=1e-8
    ):
        raise RuntimeError(
            "Total effect does not match a*b + c'. "
            "Check model specifications and data."
        )

    rng = np.random.default_rng(random_state)
    boot_results = []

    for i in range(n_boot):
        indices = rng.choice(
            len(df),
            size=len(df),
            replace=True
        )
        sample = df.iloc[indices]

        est = estimate(sample)

        boot_results.append(est)

    boot_df = pd.DataFrame(boot_results)

    # Calculate proportions only when denominators
    # are sufficiently far from zero.
    point_total = point["Total"]
    scale = max(abs(point_total), 1.0)
    tol = 1e-8 * scale

    if abs(point_total) > tol:
        point_prop = point["ACME"] / point_total
    else:
        point_prop = np.nan

    boot_df["Prop_mediated"] = np.where(
        np.abs(boot_df["Total"]) > tol,
        boot_df["ACME"] / boot_df["Total"],
        np.nan
    )

    point["Prop_mediated"] = point_prop

    # A proportion mediated can be unstable if
    # the total association is near zero.
    def summarize(key):
        values = boot_df[key].replace(
            [np.inf, -np.inf], np.nan
        ).dropna()

        if len(values) < n_boot:
            print(
                f"Warning: {key} has "
                f"{n_boot - len(values)} invalid bootstrap results."
            )

        return {
            "estimate": point[key],
            "CI": tuple(
                np.percentile(values, [2.5, 97.5])
            ) if len(values) > 0 else (np.nan, np.nan)
        }

    results = {
        key: summarize(key)
        for key in ["ACME", "ADE", "Total", "Prop_mediated"]
    }

    results["N"] = len(df)
    results["n_boot"] = n_boot
    results["formulas"] = {
        "mediator": med_formula,
        "outcome": out_formula,
        "total": total_formula
    }

    return results

